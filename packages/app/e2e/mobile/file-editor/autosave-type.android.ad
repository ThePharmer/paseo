context platform=android timeout=90000
env APP_ID=sh.paseo
env FILE=notes.txt
env MARKER=E2E_AUTOSAVED_LINE

open "${APP_ID}"
wait "id=\"workspace-header-menu-trigger\"" 30000
press "id=\"workspace-explorer-toggle\""
wait "id=\"explorer-tab-files\"" 10000
press "id=\"explorer-tab-files\""
press "id=\"files-refresh\""
wait "text=\"${FILE}\"" 15000
press "text=\"${FILE}\""
wait "id=\"file-source-viewer\"" 15000
wait "id=\"file-edit\"" 10000
press "id=\"file-edit\""
wait "id=\"file-find\"" 20000
press "id=\"file-source-editor\""
type "${MARKER}" --delay-ms 0
wait "id=\"file-edit-done\"" 5000
