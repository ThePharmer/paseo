context platform=android timeout=120000
env APP_ID=sh.paseo
env DAEMON_HOST=127.0.0.1
env DAEMON_PORT=6767
env SERVER_ID=
env WORKSPACE_ID=

open "${APP_ID}"
wait "id=\"welcome-screen\"" 60000
press "id=\"welcome-direct-connection\""
wait "id=\"add-host-modal\"" 10000
fill "id=\"direct-host-input\"" "${DAEMON_HOST}"
fill "id=\"direct-port-input\"" "${DAEMON_PORT}"
press "id=\"direct-host-submit\""
wait "id=\"open-project-submit\"" 30000
press "id=\"menu-button\""
wait "id=\"sidebar-workspace-row-${SERVER_ID}:${WORKSPACE_ID}\"" 20000
press "id=\"sidebar-workspace-row-${SERVER_ID}:${WORKSPACE_ID}\""
wait "id=\"workspace-header-menu-trigger\"" 30000
close
